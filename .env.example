ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_STATE_REPEAT_SECONDS=300
LOG_REJECT_REPEAT_SECONDS=300
# Use DEBUG temporarily when auditing every market cycle/rejection in Railway logs.
# LOG_LEVEL=DEBUG
# Comma-separated frontend origins, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=
COINW_REST_BASE_URL=https://api.coinw.com
COINW_WS_URL=wss://ws.futurescw.com/perpum
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DATABASE=kaeleon
DEFAULT_SYMBOL=BTC
DEFAULT_TIMEFRAME=5m
PAPER_INITIAL_EQUITY=100
PAPER_TAKER_FEE=0.0006
PAPER_MAKER_FEE=0.0001
PAPER_SLIPPAGE_BPS=2.0
PAPER_MAX_SPREAD_BPS=30.0
# El capital operativo configurado se usa como margen de una sola operación.
# RISK_PER_TRADE y MAX_MARGIN_FRACTION antiguos ya no limitan el tamaño.
FIXED_LEVERAGE=10
ADMIN_PHONE=+1XXXXXXXXXX

# Server-side encryption key for per-user CoinW credentials.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Subscriptions / BNB Smart Chain payments
LIVE_TRIAL_DAYS=5
PAYMENT_WALLET=
PAYMENT_NETWORK=BNB_SMART_CHAIN
BSC_RPC_URL=https://bsc-dataseed.binance.org/
USDT_BSC_CONTRACT=
USDT_DECIMALS=18

# Telegram registration verification
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=https://YOUR_PUBLIC_DOMAIN/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTO_SET_WEBHOOK=true
TELEGRAM_API_TIMEOUT_SECONDS=10

# Automatic CoinW market scanner (Trading-X logic adapted to CoinW)
MARKET_SCANNER_DEPTH=12
MARKET_SCANNER_PARALLEL=3
MARKET_SCANNER_CACHE_SECONDS=30
# Last-good shortlist survives transient CoinW scanner failures for up to 5 minutes.
MARKET_SCANNER_FAILSAFE_SECONDS=300

# Source router production default: disabled. When enabled, a TREND breakout miss
# may probe the liquidity-sweep strategy only through the source volatility gates.
STRATEGY_ROUTER_LIQUIDITY_PROBE_ENABLED=false
STRATEGY_ROUTER_LIQUIDITY_PROBE_MIN_VOL_SCORE=3
STRATEGY_ROUTER_LIQUIDITY_PROBE_MIN_CONFIDENCE=0.42
STRATEGY_ROUTER_LIQUIDITY_PROBE_MIN_SIGNAL_SCORE=74

# Run the trading worker inside the same Railway backend service.
# Keep a single backend replica while this is enabled to avoid duplicate workers.
TRADING_WORKER_ENABLED=false
ENGINE_HEARTBEAT_SECONDS=900

# Bounded persistence: keeps MongoDB off the signal -> execution critical path.
ENGINE_STATE_PERSIST_SECONDS=15
TRADE_PERSIST_TIMEOUT_SECONDS=4
TRADE_PERSIST_RETRIES=2
