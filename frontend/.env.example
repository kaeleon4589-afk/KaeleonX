# Runtime URL used by frontend/server.mjs for the same-origin /api proxy.
# Railway can keep using VITE_API_BASE_URL for compatibility, but BACKEND_URL
# is clearer and does not depend on Vite build-time injection.
BACKEND_URL=https://kaeleonx-production.up.railway.app
VITE_API_BASE_URL=https://kaeleonx-production.up.railway.app
